{
 "doctype": "DocType",
 "name": "RhoGuest Transport Vehicle",
 "module": "FNB Menu",
 "engine": "InnoDB",
 "autoname": "field:vehicle_key",
 "title_field": "vehicle_name",
 "show_title_field_in_link": 1,
 "search_fields": "vehicle_name,vehicle_key,registration_number,make_model",
 "track_changes": 1,
 "field_order": [
  "identity_section",
  "vehicle_name",
  "vehicle_key",
  "vehicle_type",
  "registration_number",
  "identity_column_break",
  "make_model",
  "color",
  "location",
  "capacity_section",
  "passenger_capacity",
  "luggage_capacity",
  "capacity_column_break",
  "enabled",
  "notes_section",
  "notes"
 ],
 "fields": [
  {"fieldname":"identity_section","label":"Vehicle Identity","fieldtype":"Section Break"},
  {"fieldname":"vehicle_name","label":"Vehicle Name","fieldtype":"Data","reqd":1,"in_list_view":1},
  {"fieldname":"vehicle_key","label":"Vehicle Key","fieldtype":"Data","reqd":1,"unique":1,"in_list_view":1},
  {"fieldname":"vehicle_type","label":"Vehicle Type","fieldtype":"Select","options":"Sedan\nSUV\nLuxury\nVan\nBus\nShuttle\nOther","default":"Sedan","reqd":1,"in_list_view":1,"in_standard_filter":1},
  {"fieldname":"registration_number","label":"Registration Number","fieldtype":"Data","reqd":1,"unique":1,"in_list_view":1},
  {"fieldname":"identity_column_break","fieldtype":"Column Break"},
  {"fieldname":"make_model","label":"Make / Model","fieldtype":"Data","in_list_view":1},
  {"fieldname":"color","label":"Colour","fieldtype":"Data"},
  {"fieldname":"location","label":"Base Location","fieldtype":"Data"},
  {"fieldname":"capacity_section","label":"Capacity & Availability","fieldtype":"Section Break"},
  {"fieldname":"passenger_capacity","label":"Passenger Capacity","fieldtype":"Int","default":"4","reqd":1,"in_list_view":1},
  {"fieldname":"luggage_capacity","label":"Luggage Capacity","fieldtype":"Int","default":"2"},
  {"fieldname":"capacity_column_break","fieldtype":"Column Break"},
  {"fieldname":"enabled","label":"Enabled","fieldtype":"Check","default":"1","in_list_view":1,"in_standard_filter":1},
  {"fieldname":"notes_section","label":"Internal Notes","fieldtype":"Section Break"},
  {"fieldname":"notes","label":"Notes","fieldtype":"Small Text"}
 ],
 "permissions": [
  {"role":"System Manager","read":1,"write":1,"create":1,"delete":1,"report":1,"export":1},
  {"role":"Sales Manager","read":1,"write":1,"create":1,"report":1},
  {"role":"Sales User","read":1}
 ],
 "sort_field":"vehicle_name",
 "sort_order":"ASC"
}
