   "label": "Laundry Items",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "items",
   "label": "Items",
   "fieldtype": "Table",
   "options": "RhoGuest Laundry Request Item",
   "reqd": 1
  },
  {
   "fieldname": "billing_section",
   "label": "Billing",
   "fieldtype": "Section Break"
  },
  {
