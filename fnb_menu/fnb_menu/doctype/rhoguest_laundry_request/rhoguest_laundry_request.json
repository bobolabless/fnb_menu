  "room_number",
  "email",
  "phone",
  "request_section",
  "requested_pickup_at",
  "pickup_note",
  "status",
  "public_token",
  "items_section",
  "items",
  "billing_section",
  "billing_preference",
  "billing_status",
  "currency",
  "estimated_total",
  "company",
  "folio_reference",
  "operations_section",
  "assigned_to",
  "collected_at",
  "ready_at",
  "delivered_at",
  "internal_notes"
 ],
