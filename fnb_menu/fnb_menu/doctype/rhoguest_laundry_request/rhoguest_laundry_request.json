   "fieldtype": "Select",
   "options": "Pay at Hotel\nCharge to Room",
   "default": "Pay at Hotel",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "billing_status",
   "label": "Billing Status",
