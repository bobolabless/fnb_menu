   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "currency",
   "label": "Currency",
   "fieldtype": "Link",
   "options": "Currency",
   "read_only": 1
  },
  {
   "fieldname": "estimated_total",
   "label": "Estimated Total",
   "fieldtype": "Currency",
   "options": "currency",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "company",
   "label": "Company",
   "fieldtype": "Link",
   "options": "Company",
   "read_only": 1
  },
  {
   "fieldname": "folio_reference",
   "label": "Room Folio Reference",
   "fieldtype": "Data",
