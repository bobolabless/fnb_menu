  },
  {
   "fieldname": "ready_at",
   "label": "Ready At",
   "fieldtype": "Datetime",
   "read_only": 1
  },
  {
   "fieldname": "delivered_at",
   "label": "Delivered At",
   "fieldtype": "Datetime",
   "read_only": 1
  },
  {
   "fieldname": "internal_notes",
   "label": "Internal Notes",
   "fieldtype": "Small Text"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
