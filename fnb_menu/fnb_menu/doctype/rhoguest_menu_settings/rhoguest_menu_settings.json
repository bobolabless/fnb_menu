{
 "doctype": "DocType",
 "name": "RhoGuest Menu Settings",
 "module": "FNB Menu",
 "issingle": 1,
 "engine": "InnoDB",
 "track_changes": 1,
 "field_order": [
  "identity_section",
  "company",
  "brand_location_label",
  "show_company_logo",
  "show_company_name",
  "presentation_section",
  "menu_theme",
  "menu_layout",
  "category_navigation",
  "show_search",
  "show_item_images",
  "show_item_description",
  "show_prices",
  "full_bleed_background",
  "guest_hub_section",
  "guest_hub_enabled",
  "guest_hub_title",
  "guest_hub_subtitle",
  "show_service_items_on_hub",
  "laundry_integration_section",
  "laundry_folio_posting_mode",
  "laundry_folio_posting_method",
  "laundry_staff_in_app_notifications",
  "laundry_guest_email_notifications",
  "laundry_staff_email_notifications",
  "laundry_operations_emails",
  "routing_section",
  "public_menu_route",
  "route_redirect_http_status",
  "keep_previous_routes",
  "route_preview",
  "legacy_qr_routes",
  "catalog_section",
  "default_selling_price_list",
  "default_food_menu",
  "default_drinks_menu",
  "hide_unavailable_items",
  "ordering_section",
  "self_ordering_enabled",
  "require_payment",
  "default_customer",
  "payment_gateway_account",
  "minimum_order_amount",
  "service_section",
  "allow_room_service",
  "allow_dine_in",
  "allow_takeaway",
  "accounting_section",
  "warehouse",
  "sales_taxes_and_charges_template"
 ],
 "fields": [
  {
   "fieldname": "identity_section",
   "label": "RhoGuest Hotel Identity",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "company",
   "label": "Hotel Company",
   "fieldtype": "Link",
   "options": "Company",
   "reqd": 1
  },
  {
   "fieldname": "brand_location_label",
   "label": "Location / Brand Subline",
   "fieldtype": "Data",
   "description": "Optional, e.g. ENUGU"
  },
  {
   "fieldname": "show_company_logo",
   "label": "Show Company Logo",
   "fieldtype": "Check",
   "default": "1"
  },
  {
   "fieldname": "show_company_name",
   "label": "Show Company Name",
   "fieldtype": "Check",
   "default": "1"
  },
  {
   "fieldname": "presentation_section",
   "label": "Menu Theme & Layout",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "menu_theme",
   "label": "Theme",
   "fieldtype": "Select",
   "options": "Classic Gold\nChampagne Noir\nIvory Prestige\nEmerald Grand\nBurgundy Royale\nMidnight Sapphire\nRoyal Amethyst\nTerracotta Luxe\nCoastal Pearl\nModern Slate",
   "default": "Classic Gold"
  },
  {
   "fieldname": "menu_layout",
   "label": "Layout",
   "fieldtype": "Select",
   "options": "Classic Ledger\nElegant Cards\nCompact List\nEditorial Columns\nModern Tiles\nMinimal Lines",
   "default": "Classic Ledger"
  },
  {
   "fieldname": "category_navigation",
   "label": "Category Navigation",
   "fieldtype": "Select",
   "options": "Sticky Pills\nFloating Categories\nBoth",
   "default": "Both"
  },
  {
   "fieldname": "show_search",
   "label": "Show Search",
   "fieldtype": "Check",
   "default": "1"
  },
  {
   "fieldname": "show_item_images",
   "label": "Show Item Pictures",
   "fieldtype": "Check",
   "default": "0"
  },
  {
   "fieldname": "show_item_description",
   "label": "Show Descriptions",
   "fieldtype": "Check",
   "default": "1"
  },
  {
   "fieldname": "show_prices",
   "label": "Show Prices",
   "fieldtype": "Check",
   "default": "1"
  },
  {
   "fieldname": "full_bleed_background",
   "label": "Full-Width Theme Background",
   "fieldtype": "Check",
   "default": "1",
   "description": "Extends the selected theme colour across the full browser width instead of showing a boxed coloured panel."
  },
  {
   "fieldname": "guest_hub_section",
   "label": "RhoGuest Guest Services Hub",
   "fieldtype": "Section Break",
   "description": "Controls the read-only public guest-services landing page at /rhoguest. Publishing individual service categories is managed in RhoGuest Service Category."
  },
  {
   "fieldname": "guest_hub_enabled",
   "label": "Enable Guest Services Hub",
   "fieldtype": "Check",
   "default": "0",
   "description": "When disabled, /rhoguest shows no hotel services. Enable only after the published service catalog has been reviewed."
  },
  {
   "fieldname": "guest_hub_title",
   "label": "Guest Hub Title",
   "fieldtype": "Data",
   "default": "Guest Services"
  },
  {
   "fieldname": "guest_hub_subtitle",
   "label": "Guest Hub Subtitle",
   "fieldtype": "Data",
   "default": "Everything you need during your stay"
  },
  {
   "fieldname": "show_service_items_on_hub",
   "label": "Show Service Items on Hub",
   "fieldtype": "Check",
   "default": "1",
   "description": "Show enabled guest-available RhoGuest Service Items beneath each published service category. This remains display-only until a workflow is implemented."
  },
  {
   "fieldname": "laundry_integration_section",
   "label": "RhoGuest Laundry Billing & Notifications",
   "fieldtype": "Section Break",
   "description": "Controls optional room-folio integration and Laundry operational notifications. These settings are restricted to System Manager.",
   "permlevel": 1
  },
  {
   "fieldname": "laundry_folio_posting_mode",
   "label": "Laundry Folio Posting Mode",
   "fieldtype": "Select",
   "options": "Manual\nCustom Integration",
   "default": "Manual",
   "reqd": 1,
   "permlevel": 1,
   "description": "Manual requires an authorized manager to record the external folio reference. Custom Integration calls the configured Python method."
  },
  {
   "fieldname": "laundry_folio_posting_method",
   "label": "Custom Folio Posting Method",
   "fieldtype": "Data",
   "permlevel": 1,
   "depends_on": "eval:doc.laundry_folio_posting_mode==\"Custom Integration\"",
   "mandatory_depends_on": "eval:doc.laundry_folio_posting_mode==\"Custom Integration\"",
   "description": "Dotted Python path. The callable receives payload=<dict> and must return {success: true, reference: <external folio reference>}."
  },
  {
   "fieldname": "laundry_staff_in_app_notifications",
   "label": "Laundry Staff In-App Notifications",
   "fieldtype": "Check",
   "default": "1",
   "permlevel": 1,
   "description": "Notify the assigned System User in Frappe when Laundry operational events occur."
  },
  {
   "fieldname": "laundry_guest_email_notifications",
   "label": "Laundry Guest Email Notifications",
   "fieldtype": "Check",
   "default": "0",
   "permlevel": 1,
   "description": "Send selected Laundry lifecycle updates to the guest email address. Disabled by default."
  },
  {
   "fieldname": "laundry_staff_email_notifications",
   "label": "Laundry Staff Email Notifications",
   "fieldtype": "Check",
   "default": "0",
   "permlevel": 1,
   "description": "Send Laundry lifecycle emails to the assigned user and configured operations recipients. Disabled by default."
  },
  {
   "fieldname": "laundry_operations_emails",
   "label": "Laundry Operations Email Recipients",
   "fieldtype": "Small Text",
   "permlevel": 1,
   "description": "Optional comma, semicolon or newline-separated operations email addresses."
  },
  {
   "fieldname": "routing_section",
   "label": "RhoGuest Public Menu & Legacy QR Routing",
   "fieldtype": "Section Break",
   "description": "Change the hotel-facing menu URL without changing the stable internal /fnb-menu endpoint. Existing printed QR routes can be retained below.",
   "permlevel": 1
  },
  {
   "fieldname": "public_menu_route",
   "label": "Public Menu Route",
   "fieldtype": "Data",
   "default": "/menu",
   "reqd": 1,
   "description": "Hotel-facing route used in new QR codes, e.g. /menu, /dine or /guest-menu. Saving Settings activates the redirect immediately.",
   "permlevel": 1
  },
  {
   "fieldname": "route_redirect_http_status",
   "label": "QR Redirect Type",
   "fieldtype": "Select",
   "options": "302\n307\n301\n308",
   "default": "302",
   "description": "302 is recommended while routes may still change. Use 301/308 only when the public URL is intended to be permanent.",
   "permlevel": 1
  },
  {
   "fieldname": "keep_previous_routes",
   "label": "Keep Previous Public Route as Alias",
   "fieldtype": "Check",
   "default": "1",
   "description": "When the Public Menu Route changes, preserve the previous route so already-printed QR codes continue to work.",
   "permlevel": 1
  },
  {
   "fieldname": "route_preview",
   "label": "Current Public URL",
   "fieldtype": "HTML",
   "permlevel": 1
  },
  {
   "fieldname": "legacy_qr_routes",
   "label": "Legacy / Existing QR Routes",
   "fieldtype": "Table",
   "options": "RhoGuest Route Alias",
   "description": "Add routes already printed on hotel QR materials. Enabled entries redirect to the current RhoGuest Food & Beverage menu.",
   "permlevel": 1
  },
  {
   "fieldname": "catalog_section",
   "label": "Published Menus",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "default_selling_price_list",
   "label": "Default Selling Price List",
   "fieldtype": "Link",
   "options": "Price List",
   "reqd": 1
  },
  {
   "fieldname": "default_food_menu",
   "label": "Food Menu",
   "fieldtype": "Link",
   "options": "RhoGuest Menu Book"
  },
  {
   "fieldname": "default_drinks_menu",
   "label": "Drinks Menu",
   "fieldtype": "Link",
   "options": "RhoGuest Menu Book"
  },
  {
   "fieldname": "hide_unavailable_items",
   "label": "Hide Unavailable Lines",
   "fieldtype": "Check",
   "default": "1"
  },
  {
   "fieldname": "ordering_section",
   "label": "RhoGuest F&B Self Ordering",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "self_ordering_enabled",
   "label": "Enable Guest Self Ordering",
   "fieldtype": "Check",
   "default": "0"
  },
  {
   "fieldname": "require_payment",
   "label": "Payment Required Before Kitchen Release",
   "fieldtype": "Check",
   "default": "1",
   "read_only": 1
  },
  {
   "fieldname": "default_customer",
   "label": "Default Guest Customer",
   "fieldtype": "Link",
   "options": "Customer"
  },
  {
   "fieldname": "payment_gateway_account",
   "label": "Payment Gateway Account",
   "fieldtype": "Link",
   "options": "Payment Gateway Account"
  },
  {
   "fieldname": "minimum_order_amount",
   "label": "Minimum Order Amount",
   "fieldtype": "Currency",
   "default": "0"
  },
  {
   "fieldname": "service_section",
   "label": "F&B Service Types",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "allow_room_service",
   "label": "Room Service",
   "fieldtype": "Check",
   "default": "1"
  },
  {
   "fieldname": "allow_dine_in",
   "label": "Dine In",
   "fieldtype": "Check",
   "default": "1"
  },
  {
   "fieldname": "allow_takeaway",
   "label": "Takeaway",
   "fieldtype": "Check",
   "default": "1"
  },
  {
   "fieldname": "accounting_section",
   "label": "Accounting & Stock",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "warehouse",
   "label": "Warehouse",
   "fieldtype": "Link",
   "options": "Warehouse"
  },
  {
   "fieldname": "sales_taxes_and_charges_template",
   "label": "Sales Taxes and Charges Template",
   "fieldtype": "Link",
   "options": "Sales Taxes and Charges Template"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1
  },
  {
   "role": "Sales Manager",
   "read": 1,
   "write": 1
  },
  {
   "role": "System Manager",
   "permlevel": 1,
   "read": 1,
   "write": 1
  }
 ]
}
